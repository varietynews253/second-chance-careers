{
  "name": "second-chance-careers",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @second-chance-careers/web",
    "dev:api": "npm run start:dev --workspace @second-chance-careers/api",
    "build": "npm run build --workspace @second-chance-careers/web && npm run build --workspace @second-chance-careers/api",
    "lint:web": "npm run lint --workspace @second-chance-careers/web",
    "dev": "NEXT_PUBLIC_API_URL=http://localhost:3003 concurrently \"PORT=3000 npm run dev:web\" \"PORT=3003 npm run dev:api\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "next-auth": "^4.24.15",
    "prisma": "^5.19.1",
    "zod": "^3.23.8"
  }
}
